+++ b/artemis/llm/deepseek.py
@@ -0,0 +1,28 @@
+"""Official DeepSeek Chat Completions compatibility, scoped to its endpoint."""
+
+from urllib.parse import urlsplit
+
+from langchain_openai import ChatOpenAI
+
+
+def is_deepseek_url(value: str | None) -> bool:
+    if not value:
+        return False
+    url = urlsplit(value)
+    return (url.scheme == "https" and url.hostname == "api.deepseek.com"
+            and url.port in (None, 443) and not url.username and not url.password
+            and not url.query and not url.fragment and url.path in ("", "/", "/v1", "/v1/"))
+
+
+class DeepSeekChatOpenAI(ChatOpenAI):
+    """Avoid OpenAI-only response_format and forced tools in thinking mode."""
+
+    def with_structured_output(self, schema=None, *, method="function_calling", **kwargs):
+        return super().with_structured_output(schema, method=method, **kwargs)
+
+    def _get_request_payload(self, *args, **kwargs):
+        payload = super()._get_request_payload(*args, **kwargs)
+        # DeepSeek's documented Chat Completions parameter is max_tokens.
+        cap = payload.pop("max_completion_tokens", payload.get("max_tokens", 2048))
+        payload["max_tokens"] = min(cap or 2048, 2048)
+        return payload
