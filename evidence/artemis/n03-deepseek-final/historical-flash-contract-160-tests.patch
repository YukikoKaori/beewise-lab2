+         patch("artemis.services.llm.get_google_llm") as google:
+        assert lens._get_llm() is expected and lens._get_fallback_llm() is expected
+        assert routed.call_count == 2
+        assert routed.call_args.kwargs == {"use_fallback": True}
+        google.assert_not_called()
+
+
+def test_actual_memory_endpoint_and_generic_explorer_selection(monkeypatch):
+    from artemis.agents.explorer.explorer import Explorer
+    from artemis.services.llm import get_memory_llm
+    monkeypatch.setenv("ARTEMIS_DEEPSEEK_ONLY", "1")
+    from artemis.config import settings
+    monkeypatch.setattr(settings, "OPENAI_BASE_URL", "https://api.deepseek.com")
+    ctx = SimpleNamespace(llm_config=config(), data_engine=None)
+    captured = []
+    with patch.object(ModelFactory, "get_model", side_effect=lambda ep: captured.append(ep)):
+        get_memory_llm(ctx, "deepseek-flash")
+    assert captured[0].provider == "openai" and captured[0].model_name == "deepseek-flash"
+    explorer = object.__new__(Explorer)
+    explorer.model_name = "deepseek-flash"
+    explorer.ctx = ctx
+    assert explorer._detect_native_engine() is False
+
+
+@pytest.mark.asyncio
+async def test_gemini_prewarm_never_called_even_if_a_key_is_passed(monkeypatch):
+    from artemis.sdk.agent import Agent
+    monkeypatch.setenv("ARTEMIS_DEEPSEEK_ONLY", "1")
+    with patch("artemis.sdk.agent.genai.Client") as google, \
+         patch("artemis.sdk.agent.ChatGoogleGenerativeAI") as gemini:
+        await Agent._prewarm_llm_connections(SimpleNamespace(), "offline-fixture-not-a-key")
+        google.assert_not_called()
+        gemini.assert_not_called()
+
+
+def test_real_flash_screenshot_serialization_and_native_action_decode():
+    runner = object.__new__(FlashRunner)
+    buffer = io.BytesIO()
+    Image.new("RGB", (8, 16), "white").save(buffer, format="JPEG")
+    jpeg = buffer.getvalue()
+    message = runner._build_tail(SimpleNamespace(elapsed_label=lambda: "T+00:00"), 1, jpeg, "[1] Tab")
+    assert message.type == "human"
+    block = next(b for b in message.content if b["type"] == "image_url")
+    assert base64.b64decode(block["image_url"]["url"].split(",")[1]) == jpeg
+    payload = ModelFactory.create_model(endpoint())._get_request_payload([message])
