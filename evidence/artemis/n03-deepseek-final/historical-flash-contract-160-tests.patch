+    assert not is_deepseek_url(url)
+
+
+def test_only_mode_rejects_google_and_wrong_endpoint(monkeypatch):
+    monkeypatch.setenv("ARTEMIS_DEEPSEEK_ONLY", "1")
+    with pytest.raises(ValueError, match="rejected"):
+        ModelFactory.create_model(ModelEndpoint(provider="google", model_name="gemini-3.8-flash"))
+    with pytest.raises(ValueError, match="rejected"):
+        ModelFactory.create_model(ModelEndpoint(provider="openai", api_base="https://api.openai.com/v1"))
