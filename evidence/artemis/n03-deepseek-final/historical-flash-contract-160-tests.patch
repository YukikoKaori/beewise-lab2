+"""Hermetic compatibility tests; no real provider/device calls."""
+
+import base64
+import io
+import json
+import socket
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock, patch
+
+import httpx
+import pytest
+from langchain_core.messages import AIMessage
+from PIL import Image
+
+from artemis.agents.flash.runner import FlashRunner
+from artemis.config.llm import LLMConfig, _expand_default_into_nodes
+from artemis.llm.deepseek import DeepSeekChatOpenAI, is_deepseek_url
+from artemis.llm.deepseek_budget import claim_request
+from artemis.llm.router import ModelEndpoint, ModelFactory
+from artemis.memory.chunking import StepCapsuleLens
+from third_party.mobile_use.agents.hopper.hopper import HopperOutput
+
+
+@pytest.fixture(autouse=True)
+def no_network(monkeypatch):
+    original = socket.socket.connect
+    def local_only(sock, address):
+        if isinstance(address, tuple) and address[0] in ("127.0.0.1", "::1"):
+            return original(sock, address)
+        pytest.fail("Unexpected external socket")
+    monkeypatch.setattr(socket.socket, "connect", local_only)
+    monkeypatch.delenv("ARTEMIS_FAKE_LLM", raising=False)
+    monkeypatch.delenv("ARTEMIS_DEEPSEEK_ONLY", raising=False)
+
+
+def endpoint(**updates):
+    return ModelEndpoint(provider="openai", model_name="deepseek-flash",
+                         api_key="offline-fixture-not-a-key", api_base="https://api.deepseek.com",
+                         **updates)
+
+
+def config():
+    raw = _expand_default_into_nodes({"default": {
+        "provider": "openai", "model": "deepseek-flash",
+        "fallback": {"provider": "openai", "model": "deepseek-flash"}}})
+    for name in ("planner_validation", "validator_pixel_safety_net", "history_analyzer", "output_analyzer"):
+        raw[name] = raw["operator"].copy()
+    return LLMConfig.model_validate(raw)
+
+
+def test_actual_config_schema_can_override_all_pro_judges_without_google():
+    cfg = config()
+    for key, value in cfg.model_dump().items():
+        rows = value.values() if key == "utils" else [value]
+        for row in rows:
+            if row:
+                assert row["provider"] == row["fallback"]["provider"] == "openai"
+                assert row["model"] == row["fallback"]["model"] == "deepseek-flash"
+
+
+def test_deepseek_routing_payload_and_structured_hopper():
+    seen = []
+    def respond(request):
+        payload = json.loads(request.content)
+        seen.append(payload)
+        name = payload["tools"][0]["function"]["name"]
+        return httpx.Response(200, json={"id": "offline", "object": "chat.completion",
+            "created": 0, "model": "deepseek-flash", "choices": [{"index": 0,
+            "finish_reason": "tool_calls", "message": {"role": "assistant", "content": "",
+            "tool_calls": [{"id": "offline-tool", "type": "function", "function": {
+                "name": name, "arguments": '{"found":true,"output":"com.beewise.beewise","reason":"offline fixture"}'}}]}}]})
+    model = ModelFactory.create_model(endpoint())
+    assert isinstance(model, DeepSeekChatOpenAI)
+    model.root_client._client = httpx.Client(transport=httpx.MockTransport(respond))
+    output = model.with_structured_output(HopperOutput).invoke("Find BeeWise; return JSON")
+    assert output.found and output.output == "com.beewise.beewise"
+    payload = seen[0]
+    assert "response_format" not in payload
+    assert payload["thinking"] == {"type": "disabled"}
+    assert payload["max_tokens"] == 2048 and "max_completion_tokens" not in payload
+    assert model.max_retries == 0
+
+
+def test_invalid_structured_output_is_rejected():
+    model = ModelFactory.create_model(endpoint())
+    with pytest.raises(Exception):
+        HopperOutput.model_validate({"found": True})
+    assert model.with_structured_output(HopperOutput) is not None
+
+
+def test_flash_receives_the_actual_requested_output_contract():
+    from artemis.config import OutputConfig
+    from third_party.mobile_use.sdk.agent import _flash_goal
+    description = '{"destinations":[{"name":string,"title_visible":true}]}'
+    actual = _flash_goal("Visit five tabs", OutputConfig(output_description=description))
+    assert actual.startswith("Visit five tabs")
+    assert description in actual
+    assert "Required output contract" in actual
+
+
+def test_flash_without_output_config_preserves_existing_goal():
+    from third_party.mobile_use.sdk.agent import _flash_goal
+    assert _flash_goal("Visit five tabs", None) == "Visit five tabs"
+
+
+def test_openai_default_behavior_unchanged():
+    normal = ModelFactory.create_model(ModelEndpoint(provider="openai", model_name="gpt-4o",
+        api_key="offline-fixture-not-a-key", api_base="https://api.openai.com/v1"))
+    assert not isinstance(normal, DeepSeekChatOpenAI)
+
+
+@pytest.mark.parametrize("url", ["http://api.deepseek.com", "https://api.deepseek.com.evil.test",
+    "https://user@api.deepseek.com", "https://api.deepseek.com:8443", "https://api.deepseek.com/beta"])
