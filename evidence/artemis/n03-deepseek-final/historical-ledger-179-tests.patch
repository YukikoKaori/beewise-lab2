new file mode 100644
index 0000000..09d58cc
--- /dev/null
+++ b/artemis/llm/deepseek_ledger.py
@@ -0,0 +1,99 @@
+"""Persistent, fail-closed batch reservations. No prompts, images or keys stored.
+
+Peak uncached Flash prices checked 2026-11-05: $0.30/M input, $1.20/M
+output. Reserve one token per non-image UTF-8 JSON byte, 4096 framing tokens,
+and the documented 1024-token maximum per image. Successful validated usage
+settles at peak uncached prices; failures retain their entire reservation.
+"""
+
+from contextlib import contextmanager
+from datetime import UTC, datetime
+import json
+from pathlib import Path
+import sqlite3
+
+
+def initialize(path: Path, *, max_requests: int, max_nanodollars: int,
+               expires_utc: str, approval_ref: str) -> None:
+    """Owner authorization must precede this operation; never overwrite a ledger."""
+    if not 1 <= max_requests <= 240 or not 1 <= max_nanodollars <= 500_000_000:
+        raise ValueError("Batch exceeds proposed request/cost ceiling")
+    if not approval_ref.strip():
+        raise ValueError("Missing exact owner approval reference")
+    with path.open("xb"):
+        pass
+    with sqlite3.connect(path) as db:
+        db.execute("CREATE TABLE budget (max_requests INTEGER, max_cost INTEGER, "
+                   "expires TEXT, approval TEXT, blocked INTEGER)")
+        db.execute("INSERT INTO budget VALUES (?, ?, ?, ?, 0)",
+                   (max_requests, max_nanodollars, expires_utc, approval_ref))
+        db.execute("CREATE TABLE attempts (id INTEGER PRIMARY KEY, utc TEXT, "
+                   "input_bound INTEGER, output_bound INTEGER, reserved INTEGER, "
+                   "status INTEGER, prompt_tokens INTEGER, completion_tokens INTEGER, charged INTEGER)")
+
+
+@contextmanager
+def transaction(path):
+    # mode=rw refuses an absent ledger; a restart cannot silently get a new cap.
+    db = sqlite3.connect(Path(path).resolve().as_uri() + "?mode=rw", uri=True, timeout=10)
+    try:
+        db.execute("PRAGMA synchronous=FULL")
+        db.execute("BEGIN IMMEDIATE")
+        yield db
+        db.commit()
+    except BaseException:
+        db.rollback()
+        raise
+    finally:
+        db.close()
+
+
+def reserve(path, *, text_bytes, images, output_tokens):
+    input_bound = text_bytes + 4096 + images * 1024
+    cost = input_bound * 300 + output_tokens * 1200  # integer nanodollars
+    with transaction(path) as db:
+        maximum, ceiling, expires, approval, blocked = db.execute(
+            "SELECT * FROM budget").fetchone()
+        if blocked or not approval or datetime.now(UTC) >= datetime.fromisoformat(expires):
+            raise ValueError("Batch blocked, expired or unauthorized; no request sent")
+        count, spent = db.execute("SELECT COUNT(*), COALESCE(SUM(COALESCE(charged, reserved)), 0) "
+                                  "FROM attempts").fetchone()
+        if count >= maximum or spent + cost > ceiling:
+            raise ValueError("Cumulative request/cost budget exhausted; no request sent")
+        cursor = db.execute("INSERT INTO attempts (utc, input_bound, output_bound, reserved) "
+                            "VALUES (?, ?, ?, ?)",
+                            (datetime.now(UTC).isoformat(), input_bound, output_tokens, cost))
+        return cursor.lastrowid
+
+
+def record_response(path, attempt, response):
+    """Read usage only. Missing/malformed successful usage blocks subsequent egress."""
+    prompt = completion = None
+    bad = False
+    if response.status_code == 200:
+        try:
+            usage = json.loads(response.content)["usage"]
+            prompt, completion = usage["prompt_tokens"], usage["completion_tokens"]
+            bad = not all(type(x) is int and x >= 0 for x in (prompt, completion))
+        except (KeyError, TypeError, ValueError):
+            bad = True
+        if bad:
+            prompt = completion = None
+    with transaction(path) as db:
+        bounds = db.execute("SELECT input_bound, output_bound, status FROM attempts WHERE id = ?",
+                            (attempt,)).fetchone()
+        if not bounds:
+            raise ValueError("Unreserved provider response")
+        if bounds[2] is not None:
+            raise ValueError("Attempt already recorded; ledger cannot be rewritten")
+        if prompt is not None and (prompt > bounds[0] or completion > bounds[1]):
+            bad = True
+        db.execute("UPDATE attempts SET status = ?, prompt_tokens = ?, completion_tokens = ? "
+                   "WHERE id = ?", (response.status_code, prompt, completion, attempt))
+        if response.status_code == 200 and not bad:
+            db.execute("UPDATE attempts SET charged = ? WHERE id = ?",
+                       (prompt * 300 + completion * 1200, attempt))
+        if bad:
+            db.execute("UPDATE budget SET blocked = 1")
+    if bad:
+        raise ValueError("Provider usage missing or exceeds reservation; batch frozen")
