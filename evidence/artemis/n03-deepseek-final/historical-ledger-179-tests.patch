+"""Run the focused regressions without external network or real credentials."""
+
+import os
+from pathlib import Path
+import socket
+import sys
+
+os.chdir(Path(__file__).resolve().parents[1])
+sys.path.insert(0, str(Path.cwd()))
+for name in ("GOOGLE_API_KEY", "GEMINI_API_KEY", "GCP_API_KEY", "OPENAI_API_KEY"):
+    os.environ[name] = "offline-fixture-not-a-key"
+os.environ.pop("ARTEMIS_DEEPSEEK_ONLY", None)
+os.environ.pop("ARTEMIS_FAKE_LLM", None)
+original_connect = socket.socket.connect
+
+
+def local_only(sock, address):
+    if isinstance(address, tuple) and address[0] in ("127.0.0.1", "::1"):
+        return original_connect(sock, address)
+    raise AssertionError("Offline checks prohibit external sockets")
+
+
+socket.socket.connect = local_only
+import pytest
+
+raise SystemExit(pytest.main([
+    "tests/unit/test_deepseek_compatibility.py",
+    "tests/unit/test_deepseek_ledger.py",
+    "tests/unit/test_llm_gateway.py", "tests/unit/test_llm_structured.py",
+    "tests/unit/agents/test_flash_runner.py",
+    "tests/unit/agents/test_flash_step_summarizer.py",
+    "tests/unit/memory/test_history_chunking.py", "-q", *sys.argv[1:],
+]))
