new file mode 100644
index 0000000..87db3de
--- /dev/null
+++ b/artemis/llm/deepseek_budget.py
@@ -0,0 +1,95 @@
+"""Optional single-smoke egress guard; zero requests permitted by default.
+
+Counts HTTP attempts before sending, shared by every model/worker via a private
+counter file. Never records headers, prompts, screenshots or credentials.
+"""
+
+import json
+import os
+from pathlib import Path
+
+import httpx
+
+
+def claim_request(request: httpx.Request):
+    if (str(request.url) != "https://api.deepseek.com/chat/completions"
+            or request.method != "POST"):
+        raise ValueError("Smoke guard rejected unexpected provider endpoint")
+    payload = json.loads(request.content)
+    if payload.get("model") != "deepseek-flash":
+        raise ValueError("Smoke guard only permits documented vision model deepseek-flash")
+    if not 1 <= payload.get("max_tokens", 0) <= 2048:
+        raise ValueError("Smoke output-token cap missing or exceeded")
+    if payload.get("stream") or payload.get("thinking", {}).get("type", "disabled") != "disabled":
+        raise ValueError("Only non-streaming, non-thinking requests are authorized")
+    # Bound non-image bytes and image count. Inline images remain in user turns.
+    images = 0
+    for message in payload.get("messages", []):
+        content = message.get("content")
+        if not isinstance(content, list):
+            continue
+        for block in content:
+            if block.get("type") == "image_url":
+                url = block["image_url"]["url"]
+                if message.get("role") != "user" or not url.startswith("data:image/"):
+                    raise ValueError("Smoke requires inline user screenshot blocks")
+                images += 1
+                block["image_url"]["url"] = "[inline image]"
+    text_bytes = len(json.dumps(payload, ensure_ascii=False).encode())
+    if images > 8 or text_bytes > 32768:
+        raise ValueError("Smoke input bound exceeded; stop instead of truncating evidence")
+    ledger = os.environ.get("ARTEMIS_DEEPSEEK_LEDGER_FILE")
+    if ledger:
+        from artemis.llm.deepseek_ledger import reserve
+        return ledger, reserve(ledger, text_bytes=text_bytes, images=images,
+                               output_tokens=payload["max_tokens"])
+    limit = int(os.environ.get("ARTEMIS_DEEPSEEK_REQUEST_LIMIT", "0"))
+    if not 1 <= limit <= 12:
+        raise ValueError("No authorized live request budget configured")
+    path = Path(os.environ["ARTEMIS_DEEPSEEK_COUNTER_FILE"])
+    # The launcher creates a new counter explicitly. Refuse missing/reused state.
+    with path.open("r+b") as file:
+        if os.name == "nt":
+            import msvcrt
+            msvcrt.locking(file.fileno(), msvcrt.LK_LOCK, 1)
+        else:
+            import fcntl
+            fcntl.flock(file, fcntl.LOCK_EX)
+        try:
+            file.seek(0)
+            count = int(file.read().decode())
+            if count >= limit:
+                raise ValueError("DeepSeek HTTP-attempt budget exhausted; no request sent")
+            file.seek(0)
+            file.write(str(count + 1).encode())
+            file.truncate()
+            file.flush()
+            os.fsync(file.fileno())
+        finally:
+            file.seek(0)
+            if os.name == "nt":
+                msvcrt.locking(file.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(file, fcntl.LOCK_UN)
+
+
+class GuardedTransport(httpx.HTTPTransport):
+    def handle_request(self, request):
+        receipt = claim_request(request)
+        response = super().handle_request(request)
+        if receipt:
+            from artemis.llm.deepseek_ledger import record_response
+            response.read()
+            record_response(*receipt, response)
+        return response
+
+
+class GuardedAsyncTransport(httpx.AsyncHTTPTransport):
+    async def handle_async_request(self, request):
+        receipt = claim_request(request)
+        response = await super().handle_async_request(request)
+        if receipt:
+            from artemis.llm.deepseek_ledger import record_response
+            await response.aread()
+            record_response(*receipt, response)
+        return response
