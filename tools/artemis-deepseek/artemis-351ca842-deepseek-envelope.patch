+def compact_flash_history(payload):
+    """Reduce historical narration only; never change observations, actions or results."""
+    def wire_bytes(value):
+        # OpenAI merges extra_body into the HTTP JSON; it isn't a wrapper key
+        # on the wire. The transport independently meters the actual request.
+        wire = {k: v for k, v in value.items() if k != "extra_body"}
+        return measure_envelope({**wire, **(value.get("extra_body") or {})})[0]
+
+    before = wire_bytes(payload)
+    if before <= MAX_NON_IMAGE_BYTES:
+        return payload
+    messages = payload["messages"]
+    if not messages or messages[-1].get("role") != "user":
+        return payload
+    compacted = list(messages)
+    candidate = {**payload, "messages": compacted}
+    for index, message in enumerate(messages[:-1]):
+        calls = message.get("tool_calls") or []
+        results = messages[index + 1 : index + 1 + len(calls)]
+        if (message.get("role") == "assistant" and isinstance(message.get("content"), str)
+                and message["content"] and calls and len(calls) == len(results)
+                and all(call.get("function", {}).get("name") in {"click", "input_text", "press_key", "swipe"}
+                        and result.get("role") == "tool"
+                        and call.get("id") == result.get("tool_call_id")
+                        for call, result in zip(calls, results, strict=True))):
+            # ponytail: the action/result pair and raw trace already retain the
+            # executed behavior. Keep all UI blocks and the output contract.
+            compacted[index] = {**message, "content": None}
+            after = wire_bytes(candidate)
+            if after <= MAX_NON_IMAGE_BYTES:
+                logger.info("deepseek_flash_history_compacted non_image_bytes_before=%d after=%d", before, after)
+                return candidate
+    # If compaction can't fit, let the original request fail at the transport.
+    return payload
