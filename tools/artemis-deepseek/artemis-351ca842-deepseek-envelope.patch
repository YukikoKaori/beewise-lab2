+        assert counter.read_text() == "0"
+        with pytest.raises(APIConnectionError):
+            await with_fallback(lambda: acomplete(llm, "short offline prompt"), fallback)
+        assert wire.await_count == 1 and counter.read_text() == "1"
+    fallback.assert_not_called()
