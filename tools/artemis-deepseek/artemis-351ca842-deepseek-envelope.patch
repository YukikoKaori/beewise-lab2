+@pytest.mark.asyncio
+@pytest.mark.parametrize("turn", [7, 8])
+async def test_flash_history_replay_compacts_only_completed_action_narration(monkeypatch, caplog, turn):
+    from artemis.services.llm import RobustChatModelWrapper, acomplete
+
+    monkeypatch.setenv("ARTEMIS_DEEPSEEK_ONLY", "1")
+    monkeypatch.setenv("ARTEMIS_DEEPSEEK_LEDGER_FILE", "offline-ledger-not-opened")
+    ep = endpoint(model_role="operator")
+    model = ModelFactory.create_model(ep)
+    runner = object.__new__(FlashRunner)
+    contract = '{"result_count":0,"empty_state_visible":true,"recovery_action_visible":true,"message":"fixture"}'
+    runner.goal = "TC-03 offline fixture. Required output contract: " + contract
+    tools = [{"type": "function", "function": {"name": name, "parameters": {"type": "object"}}}
+             for name in ("click", "input_text", "report_task_status")]
+    prompt = runner._render_system_prompt([SimpleNamespace(name=t["function"]["name"]) for t in tools])
+    ledger = TranscriptLedger(image_scrub_depth=6, image_scrub_depth_relaxed=6, pending_grace_steps=0)
+    ledger.set_static_prefix([SystemMessage(content=prompt)])
+    jpeg = io.BytesIO()
+    Image.new("RGB", (8, 16), "white").save(jpeg, format="JPEG")
+    actions = ("click", "click", "input_text", "click", "click", "input_text", "click")
+    for step, name in enumerate(actions[:turn - 1], 1):
+        tail = runner._build_tail(ledger, step, jpeg.getvalue(), f"[{step}] stale widget")
+        action = AIMessage(content="Historical action narration. " * 17, tool_calls=[{
+            "id": f"action-{step}", "name": name,
+            "args": {"text": "offline query"} if name == "input_text" else {"index": step},
+        }])
+        ledger.render([tail])
+        ledger.stage_turn([tail, action, ToolMessage(content=f"Outcome {step}", tool_call_id=f"action-{step}")])
+        ledger.commit_staged(step_key=f"step-{step}")
+    current = runner._build_tail(ledger, turn, jpeg.getvalue(), "[8] Current UI \n", is_final=turn == 8)
+    messages = ledger.render([current])
+    bound = model.bind_tools(tools)
+    baseline = model._get_request_payload(messages, **bound.kwargs)
+    wire = {k: v for k, v in baseline.items() if k != "extra_body"} | baseline["extra_body"]
+    # Replay the observed failure class at the real boundary. The old trace
+    # didn't store the live UI bytes; this is a synthetic calibration, not E2E.
+    ui = next(b for b in current.content if b.get("text", "").startswith(PRO_UI_LIST_MARKER))
+    ui["text"] += "x" * (32768 + 900 - measure_envelope(wire)[0])
+    baseline = model._get_request_payload(messages, **bound.kwargs)
+    before = {k: v for k, v in baseline.items() if k != "extra_body"} | baseline["extra_body"]
+    assert measure_envelope(before)[0] > MAX_NON_IMAGE_BYTES
+    assert measure_envelope(before)[1] <= MAX_INLINE_IMAGES
+    seen = []
+
+    async def respond(_, request):
+        payload = json.loads(request.content)
+        seen.append(payload)
+        return httpx.Response(200, json={"id": "offline", "object": "chat.completion", "created": 0,
+            "model": "deepseek-flash", "usage": {"prompt_tokens": 2, "completion_tokens": 1},
+            "choices": [{"index": 0, "finish_reason": "tool_calls", "message": {"role": "assistant",
+                "content": None, "tool_calls": [{"id": "report", "type": "function", "function": {
+                    "name": "report_task_status", "arguments": json.dumps({"status": "completed", "explanation": contract}),
+                }}]}}]})
+
+    llm = RobustChatModelWrapper(bound, None, endpoint=ep)
+    token = FLASH_STEP.set((turn, {"bytes": 31000, "images": 5, "messages": 20}))
+    try:
+        with caplog.at_level("INFO"), \
+                patch.object(httpx.AsyncHTTPTransport, "handle_async_request", respond), \
+                patch("artemis.llm.deepseek_ledger.reserve", return_value=1), \
+                patch("artemis.llm.deepseek_ledger.record_response"):
+            reply = await acomplete(llm, messages)
+    finally:
+        FLASH_STEP.reset(token)
+    assert len(seen) == 1 and json.loads(reply.tool_calls[0]["args"]["explanation"]) == json.loads(contract)
+    after = seen[0]
+    assert measure_envelope(after)[0] <= MAX_NON_IMAGE_BYTES
+    assert measure_envelope(after)[1] == measure_envelope(before)[1]
+    assert after["tools"] == before["tools"]
+    removed = 0
+    for old, new in zip(before["messages"], after["messages"], strict=True):
+        if old != new:
+            assert old.get("tool_calls") and new == {**old, "content": None}
+            removed += 1
+    assert 0 < removed < turn - 1
+    assert all(m.content.startswith("Historical action narration") for m in messages if isinstance(m, AIMessage))
+    assert "deepseek_flash_history_compacted" in caplog.text
+    assert "Historical action narration" not in caplog.text
+
