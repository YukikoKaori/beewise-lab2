+"""No live provider calls: persistent cap, concurrency and response accounting."""
+
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime, timedelta, timezone, UTC
+import sqlite3
+
+import httpx
+import pytest
+
+from artemis.llm.deepseek_budget import GuardedAsyncTransport, GuardedTransport, claim_request
+from artemis.llm.deepseek_ledger import initialize, record_response, reserve
+
+
+@pytest.fixture
+def ledger(tmp_path, monkeypatch):
+    path = tmp_path / "cumulative.sqlite"
+    initialize(path, max_requests=3, max_nanodollars=100_000_000,
+               expires_utc=(datetime.now(UTC) + timedelta(days=1)).isoformat(),
+               approval_ref="offline-test-fixture-only")
+    monkeypatch.setenv("ARTEMIS_DEEPSEEK_LEDGER_FILE", str(path))
+    return path
+
+
+def request(**updates):
+    data = {"model": "deepseek-flash", "max_tokens": 2048,
+            "thinking": {"type": "disabled"},
+            "messages": [{"role": "user", "content": "offline"}]}
+    data.update(updates)
+    return httpx.Request("POST", "https://api.deepseek.com/chat/completions", json=data)
+
+
+def test_restart_does_not_reset_or_refund_failed_attempts(ledger):
+    for _ in range(3):
+        claim_request(request())  # simulate a transport exception after reservation
+    with pytest.raises(ValueError, match="exhausted"):
+        claim_request(request())
+    with pytest.raises(FileExistsError):
+        initialize(ledger, max_requests=3, max_nanodollars=1, expires_utc="", approval_ref="test")
+
+
+def test_parallel_workers_share_exact_cap(ledger):
+    def attempt(_):
+        try:
+            return claim_request(request())
+        except ValueError:
+            return None
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        results = list(pool.map(attempt, range(20)))
+    assert sum(result is not None for result in results) == 3
+    with sqlite3.connect(ledger) as db:
+        assert db.execute("SELECT COUNT(*) FROM attempts").fetchone()[0] == 3
+
+
+def test_actual_usage_settles_without_resetting_attempts_and_pending_cost_stays_reserved(ledger):
+    with sqlite3.connect(ledger) as db:
+        db.execute("UPDATE budget SET max_cost = 4000000")
+    path, attempt = claim_request(request())
+    record_response(path, attempt, httpx.Response(200, json={"usage": {
+        "prompt_tokens": 10, "completion_tokens": 1}}))
+    claim_request(request())  # next full reservation fits after successful settlement
+    with pytest.raises(ValueError, match="cost budget exhausted"):
+        claim_request(request())
+    with sqlite3.connect(ledger) as db:
+        row = db.execute("SELECT reserved, prompt_tokens, completion_tokens, charged FROM attempts").fetchone()
+        assert db.execute("SELECT COUNT(*) FROM attempts").fetchone()[0] == 2
+    assert row[0] > 3_000_000 and row[1:] == (10, 1, 4200)
+
+
+def test_successful_receipt_cannot_be_replayed_to_rewrite_cost(ledger):
+    path, attempt = claim_request(request())
+    response = httpx.Response(200, json={"usage": {"prompt_tokens": 100, "completion_tokens": 10}})
+    record_response(path, attempt, response)
+    with pytest.raises(ValueError, match="already recorded"):
+        record_response(path, attempt, response)
+
+
+@pytest.mark.parametrize("usage", [None, {"prompt_tokens": True, "completion_tokens": 1},
+    {"prompt_tokens": 999999, "completion_tokens": 1},
+    {"prompt_tokens": 1, "completion_tokens": 2049}])
+def test_untrustworthy_usage_freezes_all_subsequent_workers(ledger, usage):
+    path, attempt = claim_request(request())
+    with pytest.raises(ValueError, match="batch frozen"):
+        record_response(path, attempt, httpx.Response(200, json={"usage": usage}))
+    with pytest.raises(ValueError, match="Batch blocked"):
+        claim_request(request())
+
+
+def test_missing_ledger_is_never_implicitly_created(tmp_path):
+    missing = tmp_path / "absent.sqlite"
+    with pytest.raises(sqlite3.OperationalError):
+        reserve(missing, text_bytes=1, images=0, output_tokens=1)
+    assert not missing.exists()
+
+
+def test_expired_approval_stops_before_claim(ledger):
+    with sqlite3.connect(ledger) as db:
+        db.execute("UPDATE budget SET expires = '2000-01-01T00:00:00+00:00'")
+    with pytest.raises(ValueError, match="expired"):
+        claim_request(request())
+
+
+def test_response_403_remains_charged_without_private_body(ledger):
+    path, attempt = claim_request(request())
+    record_response(path, attempt, httpx.Response(403, text="private-response-not-recorded"))
+    with sqlite3.connect(ledger) as db:
+        assert db.execute("SELECT status, prompt_tokens FROM attempts").fetchone() == (403, None)
+    assert b"private-response-not-recorded" not in ledger.read_bytes()
+
+
+@pytest.mark.parametrize("updates", [{"stream": True}, {"thinking": {"type": "enabled"}}])
+def test_streaming_or_thinking_cannot_bypass_bounded_usage(ledger, updates):
+    with pytest.raises(ValueError, match="non-streaming"):
+        claim_request(request(**updates))
+
+
+def test_sync_transport_uses_shared_ledger(ledger, monkeypatch):
+    monkeypatch.setattr(httpx.HTTPTransport, "handle_request", lambda *args:
+        httpx.Response(200, json={"usage": {"prompt_tokens": 50, "completion_tokens": 2}}))
+    with GuardedTransport() as transport:
+        transport.handle_request(request())
+    with sqlite3.connect(ledger) as db:
+        assert db.execute("SELECT status, prompt_tokens FROM attempts").fetchone() == (200, 50)
+
+
+@pytest.mark.asyncio
+async def test_async_transport_uses_same_shared_ledger(ledger, monkeypatch):
+    async def respond(*args):
+        return httpx.Response(200, json={"usage": {"prompt_tokens": 60, "completion_tokens": 3}})
+    monkeypatch.setattr(httpx.AsyncHTTPTransport, "handle_async_request", respond)
+    async with GuardedAsyncTransport() as transport:
+        await transport.handle_async_request(request())
+    with sqlite3.connect(ledger) as db:
+        assert db.execute("SELECT status, prompt_tokens FROM attempts").fetchone() == (200, 60)
+
+
+def test_images_and_unicode_have_conservative_input_reservation(ledger):
+    content = [{"type": "text", "text": "Tiếng Việt"},
+               {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64,AAAA"}}]
+    data = request(messages=[{"role": "user", "content": content}])
+    _, attempt = claim_request(data)
+    with sqlite3.connect(ledger) as db:
+        bound = db.execute("SELECT input_bound FROM attempts WHERE id = ?", (attempt,)).fetchone()[0]
+    assert bound >= 4096 + 1024 + len("Tiếng Việt".encode())
+    assert b"AAAA" not in ledger.read_bytes() and "Tiếng Việt".encode() not in ledger.read_bytes()
