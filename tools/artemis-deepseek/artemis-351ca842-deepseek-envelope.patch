diff --git a/artemis/llm/deepseek.py b/artemis/llm/deepseek.py
new file mode 100644
index 0000000..8c45c73
--- /dev/null
+++ b/artemis/llm/deepseek.py
@@ -0,0 +1,75 @@
+"""Official DeepSeek Chat Completions compatibility, scoped to its endpoint."""
+
+import logging
+import os
+from typing import Literal
+from urllib.parse import urlsplit
+
+from langchain_openai import ChatOpenAI
+
+from artemis.llm.deepseek_budget import FLASH_STEP, MAX_NON_IMAGE_BYTES, measure_envelope
+
+logger = logging.getLogger(__name__)
+
+
+def compact_flash_history(payload):
+    """Reduce historical narration only; never change observations, actions or results."""
+    def wire_bytes(value):
+        # OpenAI merges extra_body into the HTTP JSON; it isn't a wrapper key
+        # on the wire. The transport independently meters the actual request.
+        wire = {k: v for k, v in value.items() if k != "extra_body"}
+        return measure_envelope({**wire, **(value.get("extra_body") or {})})[0]
+
+    before = wire_bytes(payload)
+    if before <= MAX_NON_IMAGE_BYTES:
+        return payload
+    messages = payload["messages"]
+    if not messages or messages[-1].get("role") != "user":
+        return payload
+    compacted = list(messages)
+    candidate = {**payload, "messages": compacted}
+    for index, message in enumerate(messages[:-1]):
+        calls = message.get("tool_calls") or []
+        results = messages[index + 1 : index + 1 + len(calls)]
+        if (message.get("role") == "assistant" and isinstance(message.get("content"), str)
+                and message["content"] and calls and len(calls) == len(results)
+                and all(call.get("function", {}).get("name") in {"click", "input_text", "press_key", "swipe"}
+                        and result.get("role") == "tool"
+                        and call.get("id") == result.get("tool_call_id")
+                        for call, result in zip(calls, results, strict=True))):
+            # ponytail: the action/result pair and raw trace already retain the
+            # executed behavior. Keep all UI blocks and the output contract.
+            compacted[index] = {**message, "content": None}
+            after = wire_bytes(candidate)
+            if after <= MAX_NON_IMAGE_BYTES:
+                logger.info("deepseek_flash_history_compacted non_image_bytes_before=%d after=%d", before, after)
+                return candidate
+    # If compaction can't fit, let the original request fail at the transport.
+    return payload
+
+
+def is_deepseek_url(value: str | None) -> bool:
+    if not value:
+        return False
+    url = urlsplit(value)
+    return (url.scheme == "https" and url.hostname == "api.deepseek.com"
+            and url.port in (None, 443) and not url.username and not url.password
+            and not url.query and not url.fragment and url.path in ("", "/", "/v1", "/v1/"))
+
+
+class DeepSeekChatOpenAI(ChatOpenAI):
+    """Avoid OpenAI-only response_format and forced tools in thinking mode."""
+
+    def with_structured_output(self, schema=None, *,
+                               method: Literal["function_calling", "json_mode", "json_schema"] = "function_calling",
+                               **kwargs):
+        return super().with_structured_output(schema, method=method, **kwargs)
+
+    def _get_request_payload(self, *args, **kwargs):
+        payload = super()._get_request_payload(*args, **kwargs)
+        # DeepSeek's documented Chat Completions parameter is max_tokens.
+        cap = payload.pop("max_completion_tokens", payload.get("max_tokens", 2048))
+        payload["max_tokens"] = min(cap or 2048, 2048)
+        if os.environ.get("ARTEMIS_DEEPSEEK_ONLY") == "1" and FLASH_STEP.get() is not None:
+            payload = compact_flash_history(payload)
+        return payload
diff --git a/artemis/llm/deepseek_budget.py b/artemis/llm/deepseek_budget.py
new file mode 100644
index 0000000..67f9134
--- /dev/null
+++ b/artemis/llm/deepseek_budget.py
@@ -0,0 +1,145 @@
+"""Optional single-smoke egress guard; zero requests permitted by default.
+
+Counts HTTP attempts before sending, shared by every model/worker via a private
+counter file. Never records headers, prompts, screenshots or credentials.
+"""
+
+import json
+import logging
+import os
+from contextvars import ContextVar
+from pathlib import Path
+
+import httpx
+
+MAX_NON_IMAGE_BYTES = 32768
+MAX_INLINE_IMAGES = 8
+FLASH_STEP: ContextVar[tuple[int, dict[str, int]] | None] = ContextVar(
+    "deepseek_flash_step", default=None
+)
+logger = logging.getLogger(__name__)
+
+
+class LocalDeepSeekRequestError(ValueError):
+    """Rejected locally before any provider connection or inference attempt."""
+
+
+def measure_envelope(payload):
+    """Retain the existing metering definition without mutating the wire payload."""
+    messages = []
+    images = 0
+    for message in payload.get("messages", []):
+        messages.append(message)
+        content = message.get("content")
+        if not isinstance(content, list):
+            continue
+        blocks = []
+        for block in content:
+            if block.get("type") == "image_url":
+                url = block["image_url"]["url"]
+                if message.get("role") != "user" or not url.startswith("data:image/"):
+                    raise LocalDeepSeekRequestError("invalid_inline_image: Smoke requires inline user screenshot blocks")
+                images += 1
+                block = {**block, "image_url": {**block["image_url"], "url": "[inline image]"}}
+            blocks.append(block)
+        messages[-1] = {**message, "content": blocks}
+    return len(json.dumps({**payload, "messages": messages}, ensure_ascii=False).encode()), images
+
+
+def claim_request(request: httpx.Request, model_role="unassigned"):
+    if (str(request.url) != "https://api.deepseek.com/chat/completions"
+            or request.method != "POST"):
+        raise LocalDeepSeekRequestError("unexpected_endpoint: Smoke guard rejected unexpected provider endpoint")
+    payload = json.loads(request.content)
+    if payload.get("model") != "deepseek-flash":
+        raise LocalDeepSeekRequestError("unexpected_model: Smoke guard only permits documented vision model deepseek-flash")
+    if not 1 <= payload.get("max_tokens", 0) <= 2048:
+        raise LocalDeepSeekRequestError("output_cap: Smoke output-token cap missing or exceeded")
+    if payload.get("stream") or payload.get("thinking", {}).get("type", "disabled") != "disabled":
+        raise LocalDeepSeekRequestError("request_mode: Only non-streaming, non-thinking requests are authorized")
+    text_bytes, images = measure_envelope(payload)
+    reasons = []
+    if text_bytes > MAX_NON_IMAGE_BYTES:
+        reasons.append("non_image_bytes_exceeded")
+    if images > MAX_INLINE_IMAGES:
+        reasons.append("inline_images_exceeded")
+    step = FLASH_STEP.get() if model_role == "operator" else None
+    count = len(payload["messages"])
+    diagnostic = {
+        "model_role": model_role, "non_image_bytes": text_bytes, "inline_images": images,
+        "max_non_image_bytes": MAX_NON_IMAGE_BYTES, "max_inline_images": MAX_INLINE_IMAGES,
+        "messages": count, "historical_messages": max(0, count - 2) if step else None,
+        "step": step[0] if step else None, "rejection_reasons": reasons,
+    }
+    if step:
+        previous = step[1]
+        diagnostic["non_image_bytes_delta"] = text_bytes - previous.get("bytes", 0)
+        diagnostic["inline_images_delta"] = images - previous.get("images", 0)
+        diagnostic["messages_delta"] = count - previous.get("messages", 0)
+        previous.update(bytes=text_bytes, images=images, messages=count)
+    logger.log(logging.WARNING if reasons else logging.INFO, "deepseek_input_envelope %s",
+               json.dumps(diagnostic, sort_keys=True))
+    if reasons:
+        raise LocalDeepSeekRequestError(
+            f"Smoke input bound exceeded: {','.join(reasons)}; "
+            f"non_image_bytes={text_bytes}/{MAX_NON_IMAGE_BYTES}, images={images}/{MAX_INLINE_IMAGES}"
+        )
+    ledger = os.environ.get("ARTEMIS_DEEPSEEK_LEDGER_FILE")
+    if ledger:
+        from artemis.llm.deepseek_ledger import reserve
+        return ledger, reserve(ledger, text_bytes=text_bytes, images=images,
+                               output_tokens=payload["max_tokens"])
+    limit = int(os.environ.get("ARTEMIS_DEEPSEEK_REQUEST_LIMIT", "0"))
+    if not 1 <= limit <= 12:
+        raise ValueError("No authorized live request budget configured")
+    path = Path(os.environ["ARTEMIS_DEEPSEEK_COUNTER_FILE"])
+    # The launcher creates a new counter explicitly. Refuse missing/reused state.
+    with path.open("r+b") as file:
+        if os.name == "nt":
+            import msvcrt
+            msvcrt.locking(file.fileno(), msvcrt.LK_LOCK, 1)
+        else:
+            import fcntl
+            fcntl.flock(file, fcntl.LOCK_EX)
+        try:
+            file.seek(0)
+            count = int(file.read().decode())
+            if count >= limit:
+                raise ValueError("DeepSeek HTTP-attempt budget exhausted; no request sent")
+            file.seek(0)
+            file.write(str(count + 1).encode())
+            file.truncate()
+            file.flush()
+            os.fsync(file.fileno())
+        finally:
+            file.seek(0)
+            if os.name == "nt":
+                msvcrt.locking(file.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                fcntl.flock(file, fcntl.LOCK_UN)
+
+
+class GuardedTransport(httpx.HTTPTransport):
+    model_role = "unassigned"
+
+    def handle_request(self, request):
+        receipt = claim_request(request, self.model_role)
+        response = super().handle_request(request)
+        if receipt:
+            from artemis.llm.deepseek_ledger import record_response
+            response.read()
+            record_response(*receipt, response)
+        return response
+
+
+class GuardedAsyncTransport(httpx.AsyncHTTPTransport):
+    model_role = "unassigned"
+
+    async def handle_async_request(self, request):
+        receipt = claim_request(request, self.model_role)
+        response = await super().handle_async_request(request)
+        if receipt:
+            from artemis.llm.deepseek_ledger import record_response
+            await response.aread()
+            record_response(*receipt, response)
+        return response
diff --git a/artemis/llm/deepseek_ledger.py b/artemis/llm/deepseek_ledger.py
new file mode 100644
index 0000000..09d58cc
--- /dev/null
+++ b/artemis/llm/deepseek_ledger.py
@@ -0,0 +1,99 @@
+"""Persistent, fail-closed batch reservations. No prompts, images or keys stored.
+
+Peak uncached Flash prices checked 2026-11-05: $0.30/M input, $1.20/M
+output. Reserve one token per non-image UTF-8 JSON byte, 4096 framing tokens,
+and the documented 1024-token maximum per image. Successful validated usage
+settles at peak uncached prices; failures retain their entire reservation.
+"""
+
+from contextlib import contextmanager
+from datetime import UTC, datetime
+import json
+from pathlib import Path
+import sqlite3
+
+
+def initialize(path: Path, *, max_requests: int, max_nanodollars: int,
+               expires_utc: str, approval_ref: str) -> None:
+    """Owner authorization must precede this operation; never overwrite a ledger."""
+    if not 1 <= max_requests <= 240 or not 1 <= max_nanodollars <= 500_000_000:
+        raise ValueError("Batch exceeds proposed request/cost ceiling")
+    if not approval_ref.strip():
+        raise ValueError("Missing exact owner approval reference")
+    with path.open("xb"):
+        pass
+    with sqlite3.connect(path) as db:
+        db.execute("CREATE TABLE budget (max_requests INTEGER, max_cost INTEGER, "
+                   "expires TEXT, approval TEXT, blocked INTEGER)")
+        db.execute("INSERT INTO budget VALUES (?, ?, ?, ?, 0)",
+                   (max_requests, max_nanodollars, expires_utc, approval_ref))
+        db.execute("CREATE TABLE attempts (id INTEGER PRIMARY KEY, utc TEXT, "
+                   "input_bound INTEGER, output_bound INTEGER, reserved INTEGER, "
+                   "status INTEGER, prompt_tokens INTEGER, completion_tokens INTEGER, charged INTEGER)")
+
+
+@contextmanager
+def transaction(path):
+    # mode=rw refuses an absent ledger; a restart cannot silently get a new cap.
+    db = sqlite3.connect(Path(path).resolve().as_uri() + "?mode=rw", uri=True, timeout=10)
+    try:
+        db.execute("PRAGMA synchronous=FULL")
+        db.execute("BEGIN IMMEDIATE")
+        yield db
+        db.commit()
+    except BaseException:
+        db.rollback()
+        raise
+    finally:
+        db.close()
+
+
+def reserve(path, *, text_bytes, images, output_tokens):
+    input_bound = text_bytes + 4096 + images * 1024
+    cost = input_bound * 300 + output_tokens * 1200  # integer nanodollars
+    with transaction(path) as db:
+        maximum, ceiling, expires, approval, blocked = db.execute(
+            "SELECT * FROM budget").fetchone()
+        if blocked or not approval or datetime.now(UTC) >= datetime.fromisoformat(expires):
+            raise ValueError("Batch blocked, expired or unauthorized; no request sent")
+        count, spent = db.execute("SELECT COUNT(*), COALESCE(SUM(COALESCE(charged, reserved)), 0) "
+                                  "FROM attempts").fetchone()
+        if count >= maximum or spent + cost > ceiling:
+            raise ValueError("Cumulative request/cost budget exhausted; no request sent")
+        cursor = db.execute("INSERT INTO attempts (utc, input_bound, output_bound, reserved) "
+                            "VALUES (?, ?, ?, ?)",
+                            (datetime.now(UTC).isoformat(), input_bound, output_tokens, cost))
+        return cursor.lastrowid
+
+
+def record_response(path, attempt, response):
+    """Read usage only. Missing/malformed successful usage blocks subsequent egress."""
+    prompt = completion = None
+    bad = False
+    if response.status_code == 200:
+        try:
+            usage = json.loads(response.content)["usage"]
+            prompt, completion = usage["prompt_tokens"], usage["completion_tokens"]
+            bad = not all(type(x) is int and x >= 0 for x in (prompt, completion))
+        except (KeyError, TypeError, ValueError):
+            bad = True
+        if bad:
+            prompt = completion = None
+    with transaction(path) as db:
+        bounds = db.execute("SELECT input_bound, output_bound, status FROM attempts WHERE id = ?",
+                            (attempt,)).fetchone()
+        if not bounds:
+            raise ValueError("Unreserved provider response")
+        if bounds[2] is not None:
+            raise ValueError("Attempt already recorded; ledger cannot be rewritten")
+        if prompt is not None and (prompt > bounds[0] or completion > bounds[1]):
+            bad = True
+        db.execute("UPDATE attempts SET status = ?, prompt_tokens = ?, completion_tokens = ? "
+                   "WHERE id = ?", (response.status_code, prompt, completion, attempt))
+        if response.status_code == 200 and not bad:
+            db.execute("UPDATE attempts SET charged = ? WHERE id = ?",
+                       (prompt * 300 + completion * 1200, attempt))
+        if bad:
+            db.execute("UPDATE budget SET blocked = 1")
+    if bad:
+        raise ValueError("Provider usage missing or exceeds reservation; batch frozen")
