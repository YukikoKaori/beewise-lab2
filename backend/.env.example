# Copy to .env (never commit .env). All payOS values come from https://my.payos.vn.
PORT=8787
# Public HTTPS origin of this server (ngrok/Render). Used for payOS return/cancel URLs.
PUBLIC_BASE_URL=https://your-public-host.example
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Minutes a payOS checkout link stays valid (payOS expiredAt).
CHECKOUT_TTL_MINUTES=15
# Days until an issued invoice is due.
INVOICE_DUE_DAYS=3
# Firebase Admin: set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON
# kept outside the repository, and FIREBASE_PROJECT_ID=beewise-lab-3.
FIREBASE_PROJECT_ID=beewise-lab-3
GOOGLE_APPLICATION_CREDENTIALS=
# Set to 1 to consume parent responses and "I paid" requests automatically.
WORKFLOW_WATCHER=0
