# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.venv/
.pytest_cache/
__pycache__/
*.py[cod]
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/.codex-presentation-build/
/tmp/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local credentials and environment-specific configuration
.env
.env.*
!.env.example
**/service-account*.json
**/*secrets*.json

# Keep real mobile automation evidence despite the general log ignore above.
!evidence/**/*.log
